# Copy to .env.local — every variable is optional; the app runs on mock data without them.

# Canonical origin for metadata, sitemap.xml and robots.txt.
# Defaults to https://touregyptclub.com (never localhost in a production build).
NEXT_PUBLIC_SITE_URL=

# REST back end used when USE_MOCK_API = false in src/lib/api/config.js.
NEXT_PUBLIC_API_BASE_URL=

# Foursquare Places API key — SERVER-ONLY (read by the /api/places route handler,
# never sent to the browser). Without it the Explore guide shows demo data.
FSQ_KEY=
